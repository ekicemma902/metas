{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index1.html"
    },
    {
      "source": "/ads",
      "destination": "/verify.html"
    },
    {
      "source": "/ads/:path*",
      "destination": "/verify.html"
    },
    {
      "source": "/ads:path*",
      "destination": "/verify.html"
    }
  ]
}
